# /etc/systemd/system/tw-jev.service
# Jev の中継係。画面から頼まれた判定を Jev（api.typesafe.ai）に取り次ぐ。
# 動いている間だけの使い捨てユーザー（DynamicUser）で動くので、ユーザーの一覧は増えない。
# プログラムは root の持ち物の /usr/local/lib/tw-jev にあり、開発用ユーザーもデプロイも書き換えられない。
# ライブラリやホームフォルダは見えない。書けるのは使った量の記録（/var/lib/tw-jev）だけ。
[Unit]
Description=tw-bookmarks: Jev の中継係
Requires=tw-jev.socket
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
# API キー（root だけが読める 0600）。systemd が root の権限で読み、環境変数として渡す
EnvironmentFile=/etc/apps/tw-jev.env
Environment=NODE_ENV=production
StateDirectory=tw-jev
StateDirectoryMode=0700
WorkingDirectory=/usr/local/lib/tw-jev
ExecStart=/usr/bin/node /usr/local/lib/tw-jev/bin/tw-jev.js
Restart=on-failure
RestartSec=3
MemoryMax=128M
UMask=0077

InaccessiblePaths=-/var/lib/tw-bookmarks -/srv -/etc/apps
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
